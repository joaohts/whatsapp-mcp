{
  "name": "whatsapp-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Read-only WhatsApp access for Claude Desktop via local MCP",
  "license": "MIT",
  "author": "João Henrique",
  "homepage": "https://github.com/joaohts/whatsapp-mcp",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "build:renderer": "vite build",
    "build:all": "npm run build && npm run build:renderer",
    "dev:mcp": "tsx src/main/index.ts --mcp",
    "dev:renderer": "vite",
    "dev:gui": "npm run build && npm run build:renderer && electron .",
    "package": "npm run build:all && electron-builder --mac --arm64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@whiskeysockets/baileys": "^6.7.0",
    "better-sqlite3": "^12.2.0",
    "qrcode": "^1.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "cc.joaohts.WhatsAppMCP",
    "productName": "WhatsAppMCP",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ]
    }
  }
}
